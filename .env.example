# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# --- CognoDB Cloud ---
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# --- Neo4j AuraDB Free ---
AURA_URI=neo4j+s://<instance-id>.databases.neo4j.io
AURA_USER=neo4j
AURA_PASSWORD=

# --- Memgraph (self-hosted via Docker, capped resources) ---
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- FalkorDB (self-hosted via Docker, capped resources) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6380

# --- ArangoDB Community Edition (self-hosted via Docker, capped resources) ---
ARANGO_URI=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_DB=benchmark
